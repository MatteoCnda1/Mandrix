# ——— Mandrix : configuration (copie ce fichier en .env) ———

# URL publique de l'application (celle de ton tunnel Cloudflare).
APP_URL=https://mandrix.mondomaine.fr

# Mot de passe de la base PostgreSQL (mets une longue chaîne aléatoire : openssl rand -hex 24).
POSTGRES_PASSWORD=change-moi

# Fuseau horaire : sert au déballage du dimanche 20h et aux rappels.
TZ=Europe/Paris

# ——— Stockage (homelab) ———
# Photos et vidéos : dossier du partage NFS du NAS monté dans la VM/LXC.
MEDIA_PATH=/mnt/nas/mandrix/media
# Sauvegardes quotidiennes de la base (comptes, posts, messages) : aussi sur le NAS.
BACKUP_PATH=/mnt/nas/mandrix/backups
BACKUP_KEEP_DAYS=14
# Données PostgreSQL : de préférence sur le disque local de la VM (SSD), pas sur NFS.
PG_DATA_PATH=./data/postgres
# Propriétaire (uid:gid) du dossier MEDIA_PATH sur le NAS.
APP_UID=1000
APP_GID=1000

# Port exposé sur le réseau local.
APP_PORT=3000

# ——— Cloudflare Tunnel (docker compose --profile tunnel up -d) ———
CLOUDFLARE_TUNNEL_TOKEN=

# ——— Inscriptions ———
# Le premier compte (admin) s'inscrit librement ; ensuite il faut le code de parrainage d'un membre
# (visible dans son profil). INVITE_CODE est un code « maître » optionnel accepté en plus.
INVITE_CODE=
# Jeton des alertes de supervision (scripts de deploy/homelab) : notifications push aux admins.
# Générer avec : openssl rand -hex 32 — et le reporter dans /etc/mandrix-watchdog.env sur le Proxmox.
ALERT_TOKEN=
# E-mails promus administrateurs à l'inscription (le tout premier compte l'est aussi).
ADMIN_EMAILS=

# ——— Pellicule & jeu ———
# Jour (0 = dimanche … 6 = samedi) et heure du déballage.
PELLICULE_REVEAL_DAY=0
PELLICULE_REVEAL_HOUR=20
# « Moment Mandrix » : notification quotidienne à une heure aléatoire (entre ces deux heures)
# pour prendre sa photo dans les 10 minutes. MOMENT_ENABLED=false pour le désactiver.
MOMENT_ENABLED=true
MOMENT_START_HOUR=10
MOMENT_END_HOUR=21
# Durée d'une manche de Make It Friends (10 à 120 s).
GAME_ROUND_SECONDS=45
# Taille max d'un envoi (le plan gratuit Cloudflare limite à 100 Mo).
MAX_UPLOAD_MB=100

# ——— E-mails (optionnel : « mot de passe oublié ») ———
# Exemple : smtps://utilisateur:motdepasse@smtp.fournisseur.fr:465
SMTP_URL=
MAIL_FROM=Mandrix <no-reply@mondomaine.fr>

# ——— Notifications push (optionnel) ———
# Laissés vides, les clés VAPID sont générées au premier démarrage et gardées en base.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
